{
  "manifest_version": 3,
  "name": "n8n Version Control",
  "version": "1.0.0",
  "description": "Push n8n workflows to GitHub with one click",
  "permissions": [
    "storage",
    "activeTab",
    "scripting",
    "tabs"
  ],
  "host_permissions": [
    "https://api.github.com/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "*://*/workflow/*",
        "*://localhost:*/*",
        "*://127.0.0.1:*/*"
      ],
      "exclude_matches": [
        "*://api.github.com/*"
      ],
      "js": ["content.js"],
      "css": ["styles.css"],
      "run_at": "document_idle"
    }
  ],
  "content_security_policy": {
    "extension_pages": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; connect-src https://api.github.com https://* http://127.0.0.1:* http://localhost:*;"
  },
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "n8n Version Control"
  }
}

